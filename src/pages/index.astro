---
const title = 'GraphOWL: the knowledge graph engine';
const description = 'Model, query, reason over and validate connected knowledge. A Rust server with SPARQL, Cypher, OWL 2 RL reasoning, validation, time travel and a built-in MCP server for AI agents.';

const facts = [
  { big: 'W3C', small: 'RDF, SPARQL, SHACL, OWL 2 RL' },
  { big: 'MCP', small: '101 tools for AI agents, built in' },
  { big: '469', small: 'API operations, fully described' },
  { big: '1 server', small: 'written in Rust, one Postgres' },
];

const useCases = [
  { tag: 'Data', title: 'Data catalog', text: 'Definitions, owners and lineage queried like any other fact, not kept in a separate tool.', color: 'a' },
  { tag: 'Models', title: 'Domain model', text: 'An ontology proposed from your database, reviewed by a person, then checked against the data.', color: 'b' },
  { tag: 'Rules', title: 'Compliance rules', text: 'Say which records break which rule, and why, with the evidence one click away.', color: 'c' },
  { tag: 'AI', title: 'Agent context', text: 'Give an assistant reviewed, dated and traceable context instead of a pile of documents.', color: 'd' },
  { tag: 'Federation', title: 'Answers across sources', text: 'Ask a source database in place through a reviewed mapping, without copying it first.', color: 'e' },
  { tag: 'Search', title: 'Search and RAG', text: 'Keyword and semantic search that stays inside the part of the graph you can reach.', color: 'f' },
];

const features = [
  { title: 'Every fact keeps its history', text: 'Nothing is deleted, only retracted. Ask any question as it stood at an earlier moment.' },
  { title: 'Reasoning you can tell apart', text: 'OWL 2 RL derives what follows from the model, and marks it as derived so it is never mistaken for stated.' },
  { title: 'Review before effect', text: 'Models proposed by software are proposals until a person approves them. Nothing changes the graph unreviewed.' },
  { title: 'SPARQL and Cypher', text: 'Two ways to ask the same graph. SPARQL 1.1 and a documented Cypher subset, with honest errors.' },
  { title: 'Validation built in', text: 'SHACL-style constraints and quality expectations report what does not fit, without changing it.' },
  { title: 'Packs for any domain', text: 'Ontology, glossary, rules and expectations bundled per domain, so one engine serves many.' },
  { title: 'Virtual graphs', text: 'Query a source database in place, through a mapping a reviewer approved.' },
  { title: 'People and agents, one engine', text: 'A console, an HTTP API, client libraries and an MCP server, all on the same facts.' },
];

const comparison = [
  ['Meaning (ontology, rules) lives in the data', 'yes', 'no', 'no'],
  ['Facts keep history; ask as of any moment', 'yes', 'rarely', 'rarely'],
  ['Inferred facts are marked as inferred', 'yes', 'n/a', 'n/a'],
  ['Software proposes, a person approves', 'yes', 'no', 'no'],
  ['Built-in MCP server for AI agents', 'yes', 'add-on', 'add-on'],
];

const health = `curl https://demo.graphowl.app/health
# {"status":"alive","version":"0.1.0"}`;
const curl = `curl -X POST $URL/sparql \\
  -H "Authorization: Bearer $TOKEN" \\
  -H "Content-Type: application/json" \\
  -d '{"query": "SELECT ?class (COUNT(?s) AS ?n)
        WHERE { GRAPH ?g { ?s a ?class } }
        GROUP BY ?class ORDER BY DESC(?n)"}'`;
const py = `from graphowl import GraphOWL

owl = GraphOWL(url=URL, api_key=TOKEN)
rows = owl.query.sparql("""
  SELECT ?class (COUNT(?s) AS ?n)
  WHERE { GRAPH ?g { ?s a ?class } }
  GROUP BY ?class ORDER BY DESC(?n)""")`;
const ts = `const res = await fetch(\`\${URL}/sparql\`, {
  method: "POST",
  headers: { Authorization: \`Bearer \${TOKEN}\`,
             "Content-Type": "application/json" },
  body: JSON.stringify({ query: \`SELECT ?class (COUNT(?s) AS ?n)
    WHERE { GRAPH ?g { ?s a ?class } }
    GROUP BY ?class ORDER BY DESC(?n)\` }),
});
const { rows } = await res.json();`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" sizes="32x32" href="/assets/favicon-32.png" />
    <link rel="apple-touch-icon" href="/assets/apple-touch-icon-180.png" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="GraphOWL" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content="https://graphowl.app/" />
    <meta property="og:image" content="https://graphowl.app/assets/social-preview.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="GraphOWL, the knowledge graph engine" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="canonical" href="https://graphowl.app/" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700&family=JetBrains+Mono:wght@400;600&display=swap" rel="stylesheet" />
  </head>
  <body>
    <header class="top">
      <div class="wrap bar">
        <a class="brand" href="/" aria-label="GraphOWL"><img src="/assets/owl.png" alt="" width="34" height="34" /><span>Graph<b>OWL</b></span></a>
        <nav aria-label="Primary">
          <a href="#features">Features</a>
          <a href="#use-cases">Use cases</a>
          <a href="#how">How it works</a>
          <a href="#run">Run it</a>
          <a href="/docs/">Docs</a>
        </nav>
        <div class="cta">
          <a class="btn ghost" href="https://github.com/graphowl/graphowl">GitHub</a>
          <a class="btn solid" href="/docs/start/quickstart/">Get started</a>
        </div>
      </div>
    </header>

    <section class="hero">
      <div class="wrap hero-grid">
        <div>
          <p class="chips"><span>Early access</span><span>Rust</span><span>HTTP</span><span>MCP</span></p>
          <h1>The <em>knowledge graph</em> engine.</h1>
          <p class="lede">Model, query, reason over and validate connected knowledge from your databases, documents and systems. History, rules and validation are part of the engine, not added on top of it.</p>
          <p class="hero-cta">
            <a class="btn solid big" href="/docs/start/quickstart/">Get started</a>
            <a class="btn ghost big" href="mailto:connect@graphowl.app?subject=GraphOWL%20demo%20access">Request demo access</a>
          </p>
        </div>
        <svg class="graphic" viewBox="0 0 520 420" role="img" aria-label="A small graph: farms supply milk lots, which are tested and made into batches that go to retailers">
          <defs>
            <linearGradient id="n1" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#5cc7d8"/><stop offset="1" stop-color="#0498ab"/></linearGradient>
            <linearGradient id="n2" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#8a7bf0"/><stop offset="1" stop-color="#4a3fb5"/></linearGradient>
            <linearGradient id="n3" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#34d3a0"/><stop offset="1" stop-color="#0f9d78"/></linearGradient>
            <linearGradient id="n4" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#ffb35c"/><stop offset="1" stop-color="#e0742a"/></linearGradient>
            <linearGradient id="n5" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#2a6fb0"/><stop offset="1" stop-color="#16407a"/></linearGradient>
            <filter id="glow" x="-30%" y="-30%" width="160%" height="160%"><feDropShadow dx="0" dy="6" stdDeviation="8" flood-color="#000" flood-opacity=".35"/></filter>
          </defs>
          <g stroke="#5cc7d8" stroke-opacity=".55" stroke-width="2.5" fill="none" stroke-linecap="round">
            <path d="M120 100 C150 140 200 160 235 185"/>
            <path d="M345 185 C360 150 360 125 350 97"/>
            <path d="M250 238 C220 280 190 300 160 318"/>
            <path d="M320 238 C370 270 395 285 410 305"/>
            <path d="M180 74 C220 70 250 68 285 71" stroke-dasharray="6 7"/>
          </g>
          <g filter="url(#glow)" font-family="Outfit, sans-serif" font-weight="600" font-size="17" fill="#fff" text-anchor="middle">
            <rect x="60" y="48" width="120" height="52" rx="16" fill="url(#n3)"/><text x="120" y="80">Farm</text>
            <rect x="215" y="180" width="130" height="58" rx="18" fill="url(#n1)"/><text x="280" y="215">MilkLot</text>
            <rect x="285" y="45" width="130" height="52" rx="16" fill="url(#n2)"/><text x="350" y="77">QualityTest</text>
            <rect x="80" y="318" width="140" height="52" rx="16" fill="url(#n4)"/><text x="150" y="350">Batch</text>
            <rect x="350" y="305" width="130" height="52" rx="16" fill="url(#n5)"/><text x="415" y="337">Retailer</text>
          </g>
          <g font-family="JetBrains Mono, monospace" font-size="12" fill="#a9e3ec" text-anchor="middle">
            <text x="150" y="156" transform="rotate(30 150 156)">supplies</text>
            <text x="378" y="150" transform="rotate(-80 378 150)">measures</text>
            <text x="190" y="290" transform="rotate(-38 190 290)">madeFrom</text>
            <text x="378" y="282" transform="rotate(30 378 282)">soldTo</text>
          </g>
        </svg>
      </div>
    </section>

    <section class="strip">
      <div class="wrap strip-grid">
        {facts.map((f) => <div><b>{f.big}</b><span>{f.small}</span></div>)}
      </div>
    </section>

    <section class="band" id="quick">
      <div class="wrap">
        <h2>Up and running in five minutes</h2>
        <p class="sub">A live demo to try now, or a container to run yourself.</p>
        <div class="steps">
          <div class="step"><span class="num">01</span><div><h3>Get access</h3><p>Email for a demo login, or for the early-access container.</p></div><pre><code>connect@graphowl.app</code></pre></div>
          <div class="step"><span class="num">02</span><div><h3>Check it is up</h3><p>One call, no setup.</p></div><pre><code>{health}</code></pre></div>
          <div class="step"><span class="num">03</span>
            <div><h3>Ask a question</h3><p>Count what the graph holds, by class.</p>
              <div class="tabs" role="tablist" aria-label="Language">
                <button role="tab" aria-selected="true" data-tab="curl">curl</button>
                <button role="tab" aria-selected="false" data-tab="py">Python</button>
                <button role="tab" aria-selected="false" data-tab="ts">TypeScript</button>
              </div>
            </div>
            <div class="codes">
              <pre data-pane="curl"><code>{curl}</code></pre>
              <pre data-pane="py" hidden><code>{py}</code></pre>
              <pre data-pane="ts" hidden><code>{ts}</code></pre>
            </div>
          </div>
        </div>
        <p class="more"><a href="/docs/start/quickstart/">Read the full quickstart →</a></p>
      </div>
    </section>

    <section class="band alt" id="use-cases">
      <div class="wrap">
        <h2>Built for real workloads</h2>
        <p class="sub">One engine, many domains. A data catalog, a compliance model or a product domain is one pack on the same engine.</p>
        <div class="cards">
          {useCases.map((u) => (
            <article class={`card c-${u.color}`}><span class="tag">{u.tag}</span><h3>{u.title}</h3><p>{u.text}</p></article>
          ))}
        </div>
      </div>
    </section>

    <section class="band" id="features">
      <div class="wrap">
        <h2>What you get</h2>
        <p class="sub">Not a metadata catalog with a graph bolted on: the engine does the work.</p>
        <div class="feat">
          {features.map((f) => <div><h3>{f.title}</h3><p>{f.text}</p></div>)}
        </div>
      </div>
    </section>

    <section class="band alt" id="see">
      <div class="wrap">
        <h2>See it</h2>
        <p class="sub">The console on a synthetic dairy cooperative: farms, milk lots, quality tests, batches and sales as one connected graph.</p>
        <img class="shot" src="/assets/console-overview.jpg" alt="The GraphOWL console showing a synthetic dairy cooperative" width="1200" loading="lazy" />
      </div>
    </section>

    <section class="band" id="how">
      <div class="wrap">
        <h2>How it works</h2>
        <p class="sub">From scattered data to answers you can trust, in five steps. Every step is reviewed, dated and traceable.</p>
        <img class="diagram" src="/assets/pipeline.svg" alt="Connect, model, review, ask and check, serve" loading="lazy" />
        <img class="diagram" src="/assets/architecture.svg" alt="One engine, three layers: people and agents, domain models, the engine" loading="lazy" />
      </div>
    </section>

    <section class="band alt" id="compare">
      <div class="wrap">
        <h2>How it differs</h2>
        <p class="sub">Compared by category, on rows you can check. A general database stores rows; a graph database stores connections; GraphOWL also keeps what the connections <em>mean</em>.</p>
        <div class="tablewrap">
          <table>
            <thead><tr><th></th><th class="us">GraphOWL</th><th>Relational database</th><th>Property-graph server</th></tr></thead>
            <tbody>
              {comparison.map((r) => (
                <tr><th scope="row">{r[0]}</th><td class="us">{r[1]}</td><td>{r[2]}</td><td>{r[3]}</td></tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="note">Categories describe typical products, not every one. If a row is wrong for a tool you use, tell us.</p>
      </div>
    </section>

    <section class="band" id="rust">
      <div class="wrap">
        <h2>Built in Rust</h2>
        <p class="sub">The server is written in Rust, as a workspace of small, single-purpose crates.</p>
        <div class="feat three">
          <div><h3>Safe and steady</h3><p>Memory safety without a garbage collector: whole classes of crashes and security flaws cannot be written in safe code, and there are no collector pauses to show up as latency spikes.</p></div>
          <div><h3>One server to run</h3><p>The server, the API and the console ship as one program. No runtime or virtual machine to install, and few moving parts to operate.</p></div>
          <div><h3>Rules in the types</h3><p>A fact has a source, a derived fact is marked derived, a model change needs review. These are encoded in types, so breaking them is a compile error.</p></div>
        </div>
        <p class="note">No benchmark figures are claimed yet; they will be published with the method that produced them.</p>
      </div>
    </section>

    <section class="band alt" id="run">
      <div class="wrap">
        <h2>Two ways to run it</h2>
        <div class="two">
          <article class="run a">
            <h3>Try the hosted demo</h3>
            <p>A live server loaded with a synthetic dairy cooperative. Password-protected while GraphOWL is in early access: email for a login.</p>
            <a class="btn solid" href="mailto:connect@graphowl.app?subject=GraphOWL%20demo%20access">Request demo access</a>
          </article>
          <article class="run b">
            <h3>Run it yourself</h3>
            <p>An early-access container: PostgreSQL with pgvector and one server, started with <code>docker compose</code>, on amd64 or arm64. Provided under an evaluation licence.</p>
            <a class="btn solid" href="/docs/operators/deploy/">Read how</a>
          </article>
        </div>
      </div>
    </section>

    <section class="band" id="open">
      <div class="wrap">
        <h2>What is open, and what is not</h2>
        <div class="two">
          <article class="open">
            <h3>Public</h3>
            <ul>
              <li>Documentation and the full API description</li>
              <li>Client libraries (Python and TypeScript, Apache-2.0)</li>
              <li>Runnable examples and sample data</li>
              <li>Standards conformance, dated</li>
              <li>Software bill of materials and licences</li>
              <li>Issues, discussions and a security policy</li>
            </ul>
          </article>
          <article class="open">
            <h3>Not public</h3>
            <ul>
              <li>The server's source code: it is proprietary</li>
              <li>Production use is not covered by the evaluation licence</li>
            </ul>
            <p class="note">GraphOWL is in <strong>early access</strong>: the API may change before 1.0, and <a href="/docs/reference/limits/">known limits</a> are listed plainly.</p>
          </article>
        </div>
      </div>
    </section>

    <section class="final">
      <div class="wrap">
        <h2>Start with the quickstart</h2>
        <p>Five minutes to a first question, on the demo or on your own machine.</p>
        <p><a class="btn solid big" href="/docs/start/quickstart/">Get started</a> <a class="btn ghost big" href="https://github.com/graphowl/graphowl">View on GitHub</a></p>
      </div>
    </section>

    <footer>
      <div class="wrap foot">
        <div><a class="brand" href="/"><img src="/assets/owl.png" alt="" width="28" height="28" /><span>Graph<b>OWL</b></span></a><p>The knowledge graph engine.</p></div>
        <div><h4>Product</h4><a href="#features">Features</a><a href="#use-cases">Use cases</a><a href="#run">Run it</a></div>
        <div><h4>Resources</h4><a href="/docs/">Documentation</a><a href="/docs/api/reference/">API reference</a><a href="/docs/ai/mcp-overview/">MCP and agents</a><a href="https://github.com/graphowl/examples">Examples</a></div>
        <div><h4>Project</h4><a href="https://github.com/graphowl/graphowl">GitHub</a><a href="https://github.com/graphowl/graphowl/blob/main/CHANGELOG.md">Changelog</a><a href="https://github.com/graphowl/graphowl/blob/main/SECURITY.md">Security</a><a href="/docs/project/licences/">Licences</a><a href="mailto:connect@graphowl.app">connect@graphowl.app</a></div>
      </div>
      <div class="wrap legal">The demo contains synthetic data only. The GraphOWL name and logos are not licensed for reuse; see the brand terms.</div>
    </footer>

    <script is:inline>
      document.querySelectorAll('.tabs').forEach(function (tabs) {
        var scope = tabs.closest('.step');
        tabs.addEventListener('click', function (e) {
          var b = e.target.closest('button[data-tab]');
          if (!b) return;
          tabs.querySelectorAll('button').forEach(function (x) { x.setAttribute('aria-selected', String(x === b)); });
          scope.querySelectorAll('[data-pane]').forEach(function (p) { p.hidden = p.getAttribute('data-pane') !== b.dataset.tab; });
        });
      });
    </script>
  </body>
</html>

<style is:global>
  :root { --navy:#0b1f3f; --teal:#0498ab; --light:#5cc7d8; --mist:#f2fafc; --ink:#13263a; --muted:#4a5b64; --line:#d6e6ea; }
  * { box-sizing: border-box; }
  html { scroll-behavior: smooth; }
  body { margin:0; font-family:'Outfit',system-ui,-apple-system,'Segoe UI',sans-serif; color:var(--ink); background:#fff; line-height:1.55; -webkit-font-smoothing:antialiased; }
  a { color: var(--teal); }
  img { max-width:100%; height:auto; }
  .wrap { max-width:1140px; margin:0 auto; padding:0 24px; }
  code, pre { font-family:'JetBrains Mono',ui-monospace,Menlo,monospace; }

  .top { position:sticky; top:0; z-index:20; background:rgba(11,31,63,.92); backdrop-filter:blur(10px); border-bottom:1px solid rgba(92,199,216,.18); }
  .bar { display:flex; align-items:center; gap:24px; height:64px; }
  .brand { display:flex; align-items:center; gap:10px; text-decoration:none; color:#fff; font-weight:700; font-size:22px; letter-spacing:-.01em; }
  .brand b { color:var(--light); }
  .brand img { border-radius:8px; background:#fff; }
  nav { display:flex; gap:22px; margin-left:auto; }
  nav a { color:#cfe6ec; text-decoration:none; font-weight:500; font-size:15px; }
  nav a:hover { color:#fff; }
  .cta { display:flex; gap:10px; }
  .btn { display:inline-block; padding:9px 18px; border-radius:10px; font-weight:600; font-size:15px; text-decoration:none; border:1.5px solid transparent; transition:transform .15s, box-shadow .15s; }
  .btn:hover { transform:translateY(-1px); }
  .btn.solid { background:linear-gradient(135deg,#5cc7d8,#0498ab); color:#04222a; box-shadow:0 6px 18px rgba(4,152,171,.35); }
  .btn.ghost { border-color:rgba(92,199,216,.55); color:#dff4f8; }
  .final .btn.ghost { color:#dff4f8; }
  .btn.big { padding:13px 26px; font-size:17px; border-radius:12px; }

  .hero { background:radial-gradient(1200px 600px at 78% 10%, #12396a 0%, transparent 60%), linear-gradient(180deg,#0b1f3f,#0a1a35); color:#fff; padding:72px 0 80px; overflow:hidden; }
  .hero-grid { display:grid; grid-template-columns:1.05fr .95fr; gap:40px; align-items:center; }
  .chips { display:flex; gap:8px; flex-wrap:wrap; margin:0 0 20px; }
  .chips span { font-family:'JetBrains Mono',monospace; font-size:12px; padding:4px 10px; border-radius:999px; background:rgba(92,199,216,.14); color:#a9e3ec; border:1px solid rgba(92,199,216,.35); }
  h1 { font-size:clamp(40px,6vw,64px); line-height:1.04; letter-spacing:-.025em; margin:0 0 18px; font-weight:700; }
  h1 em { font-style:normal; background:linear-gradient(135deg,#5cc7d8,#8a7bf0); -webkit-background-clip:text; background-clip:text; color:transparent; }
  .lede { font-size:19px; color:#c9dbe3; max-width:560px; margin:0 0 28px; }
  .hero-cta { display:flex; gap:14px; flex-wrap:wrap; margin:0; }
  .graphic { width:100%; height:auto; }

  .strip { background:var(--mist); border-bottom:1px solid var(--line); }
  .strip-grid { display:grid; grid-template-columns:repeat(4,1fr); gap:16px; padding:26px 24px; }
  .strip-grid div { display:flex; flex-direction:column; }
  .strip-grid b { font-size:28px; font-weight:700; color:var(--navy); letter-spacing:-.01em; }
  .strip-grid span { font-size:14px; color:var(--muted); }

  .band { padding:84px 0; }
  .band.alt { background:var(--mist); }
  h2 { font-size:clamp(30px,4vw,42px); letter-spacing:-.02em; line-height:1.1; margin:0 0 10px; color:var(--navy); }
  h3 { margin:0 0 6px; font-size:20px; color:var(--navy); }
  .sub { color:var(--muted); font-size:18px; max-width:760px; margin:0 0 36px; }
  .more { margin-top:26px; font-weight:600; }
  .note { color:var(--muted); font-size:14px; margin-top:20px; }

  .steps { display:grid; gap:18px; }
  .step { display:grid; grid-template-columns:56px 1fr 1.3fr; gap:18px; align-items:start; background:#fff; border:1px solid var(--line); border-radius:18px; padding:22px; box-shadow:0 10px 30px rgba(11,31,63,.05); }
  .num { font-family:'JetBrains Mono',monospace; font-weight:600; font-size:22px; color:#fff; background:linear-gradient(135deg,#5cc7d8,#0498ab); width:48px; height:48px; border-radius:14px; display:grid; place-items:center; }
  .step p { margin:0; color:var(--muted); }
  pre { margin:0; background:#0b1f3f; color:#d7eef3; border-radius:12px; padding:16px 18px; overflow:auto; font-size:13px; line-height:1.6; }
  .tabs { display:inline-flex; margin-top:14px; border:1px solid var(--line); border-radius:10px; overflow:hidden; }
  .tabs button { font:inherit; font-size:13px; font-weight:600; padding:7px 14px; background:#fff; border:0; color:var(--muted); cursor:pointer; }
  .tabs button[aria-selected='true'] { background:var(--navy); color:#fff; }

  .cards { display:grid; grid-template-columns:repeat(3,1fr); gap:18px; }
