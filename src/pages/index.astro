---
const title = 'GraphOWL: the semantic layer for your data and your agents';
const description = 'Describe your business once. GraphOWL maps it to your databases, answers questions in your own concepts, explains every answer and keeps AI agents inside the rules. Rust server, SPARQL, Cypher, reasoning, validation and a built-in MCP server.';

const facts = [
  { big: 'In place', small: 'query sources without copying them' },
  { big: 'Explained', small: 'derived facts marked, history kept' },
  { big: 'MCP', small: '101 tools for agents, with grants' },
  { big: '1 server', small: 'written in Rust, one Postgres' },
];

const useCases = [
  { tag: 'Access', title: 'Query data where it lives', text: 'Ask a source database in place through an approved mapping, in business concepts, without bulk-copying it into a graph store.', color: 'a' },
  { tag: 'Models', title: 'From vocabulary to executable semantics', text: 'Take terms from candidate to class, property and source mapping, with validation and a query at the end of the path.', color: 'b' },
  { tag: 'Rules', title: 'Compliance rules', text: 'Say which records break which rule, and why, with the evidence one click away.', color: 'c' },
  { tag: 'Agents', title: 'Guardrails for AI agents', text: 'Agents work through the model: scoped to a workspace, limited by a grant, proposing changes that a person approves.', color: 'd' },
  { tag: 'Integration', title: 'One meaning, many systems', text: 'Reconcile inconsistent terms across databases and applications while keeping what each source means.', color: 'e' },
  { tag: 'Catalog', title: 'Data catalog and lineage', text: 'Definitions, owners and lineage queried like any other fact, in the same graph as the domain model.', color: 'f' },
];

const pillars = [
  { tag: 'Access', color: 'a', title: 'Ask in business concepts', text: 'A semantic model maps Farm, MilkLot and QualityMeasurement to real tables, columns and keys. A virtual graph answers a question from the source database itself, so the data does not have to move.' },
  { tag: 'Trust', color: 'b', title: 'Know why an answer is what it is', text: 'Every fact keeps its source and its history. Reasoning is stored apart and marked as derived, with the rule that produced it, so a conclusion can be checked or challenged.' },
  { tag: 'Change', color: 'c', title: 'Evolve the model safely', text: 'Proposals, a review queue and decisions with reasons. Model diffs and competency questions show what a change touches before it takes effect.' },
  { tag: 'Agents', color: 'd', title: 'Keep agents inside the rules', text: 'An MCP server with 101 tools, workspace-scoped sessions and grants. Refusals are recorded. Agents propose; people decide.' },
];

const direction = [
  { title: 'Plan across sources', text: 'An ontology-aware planner that chooses where each part of a question runs, pushes work down to the databases, and keeps data transfer small.' },
  { title: 'Know what a change will break', text: 'Before a class, property or mapping changes, list the queries, constraints, virtual graphs and derived facts it affects.' },
  { title: 'Trace every answer', text: 'From the business question, through ontology terms and approved mappings, to the generated source query and the rows that support the result.' },
  { title: 'Test the model', text: 'Business questions as executable regression tests, run on every proposed change, with a quality scorecard for each pack.' },
  { title: 'Governed writes', text: 'Change a business fact through the model and propagate it to the right source with authorization, validation and an audit trail.' },
  { title: 'Version the whole model', text: 'Ontology, mappings, rules and vocabulary versioned together, reviewed as semantic diffs, and reversible.' },
];


const features = [
  { title: 'Every fact keeps its history', text: 'Nothing is deleted, only retracted. Ask any question as it stood at an earlier moment.' },
  { title: 'Reasoning you can tell apart', text: 'OWL 2 RL derives what follows from the model, and marks it as derived so it is never mistaken for stated.' },
  { title: 'Review before effect', text: 'Models proposed by software are proposals until a person approves them. Nothing changes the graph unreviewed.' },
  { title: 'SPARQL and Cypher', text: 'Two ways to ask the same graph. SPARQL 1.1 and a documented Cypher subset, with honest errors.' },
  { title: 'Validation built in', text: 'SHACL-style constraints and quality expectations report what does not fit, without changing it.' },
  { title: 'Packs for any domain', text: 'Ontology, glossary, rules and expectations bundled per domain, so one engine serves many.' },
  { title: 'Virtual graphs', text: 'Query a source database in place, through a mapping a reviewer approved.' },
  { title: 'People and agents, one engine', text: 'A console, an HTTP API, client libraries and an MCP server, all on the same facts.' },
];

const comparison = [
  ['Meaning (ontology, rules) lives in the data', 'yes', 'no', 'no'],
  ['Facts keep history; ask as of any moment', 'yes', 'rarely', 'rarely'],
  ['Inferred facts are marked as inferred', 'yes', 'n/a', 'n/a'],
  ['Software proposes, a person approves', 'yes', 'no', 'no'],
  ['Built-in MCP server for AI agents', 'yes', 'add-on', 'add-on'],
];

const sparql = `SELECT ?class (COUNT(?s) AS ?n)
WHERE { GRAPH ?g { ?s a ?class } }
GROUP BY ?class ORDER BY DESC(?n)`;
const curl = `export PASSCODE=OWL-XXXX-XXXX
curl -X POST https://demo.graphowl.app/sparql \\
  -H "Authorization: Bearer $PASSCODE" \\
  -H "Content-Type: application/json" \\
  -d '{"query": "SELECT ?class (COUNT(?s) AS ?n)
        WHERE { GRAPH ?g { ?s a ?class } }
        GROUP BY ?class ORDER BY DESC(?n)"}'`;
const py = `from graphowl import GraphOWL

owl = GraphOWL(url="https://demo.graphowl.app",
               api_key="OWL-XXXX-XXXX", workspace="dairy-coop")
rows = owl.query.sparql("""
  SELECT ?class (COUNT(?s) AS ?n)
  WHERE { GRAPH ?g { ?s a ?class } }
  GROUP BY ?class ORDER BY DESC(?n)""")`;
const ts = `const res = await fetch("https://demo.graphowl.app/sparql", {
  method: "POST",
  headers: { Authorization: "Bearer OWL-XXXX-XXXX",
             "Content-Type": "application/json" },
  body: JSON.stringify({ query: \`SELECT ?class (COUNT(?s) AS ?n)
    WHERE { GRAPH ?g { ?s a ?class } }
    GROUP BY ?class ORDER BY DESC(?n)\` }),
});
const { rows } = await res.json();`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" sizes="32x32" href="/assets/favicon-32.png" />
    <link rel="apple-touch-icon" href="/assets/apple-touch-icon-180.png" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="GraphOWL" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content="https://graphowl.app/" />
    <meta property="og:image" content="https://graphowl.app/assets/social-preview.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="GraphOWL, the knowledge graph engine" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="canonical" href="https://graphowl.app/" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700&family=JetBrains+Mono:wght@400;600&display=swap" rel="stylesheet" />
  </head>
  <body>
    <header class="top">
      <div class="wrap bar">
        <a class="brand" href="/" aria-label="GraphOWL"><img src="/assets/owl.png" alt="" width="34" height="34" /><span>Graph<b>OWL</b></span></a>
        <nav aria-label="Primary">
          <a href="#pillars">What it does</a>
          <a href="#use-cases">Use cases</a>
          <a href="#how">How it works</a>
          <a href="#cookbooks">Cookbooks</a>
          <a href="#run">Run it</a>
          <a href="https://docs.graphowl.app/">Docs</a>
        </nav>
        <div class="cta">
          <a class="btn ghost" href="https://github.com/graphowl/graphowl">GitHub</a>
          <a class="btn solid" href="https://docs.graphowl.app/start/quickstart/">Get started</a>
        </div>
      </div>
    </header>

    <section class="hero">
      <div class="wrap hero-grid">
        <div>
          <p class="chips"><span>Early access</span><span>Rust</span><span>HTTP</span><span>MCP</span></p>
          <h1>The <em>semantic layer</em> for your data and your agents.</h1>
          <p class="lede">Describe your business once. GraphOWL maps it to your databases, answers questions in your own concepts, explains every answer, and keeps AI agents inside the rules. History, validation and review are part of the engine, not added on top of it.</p>
          <p class="hero-cta">
            <a class="btn solid big" href="https://docs.graphowl.app/start/quickstart/">Get started</a>
            <a class="btn ghost big" href="mailto:connect@graphowl.app?subject=GraphOWL%20demo%20access">Request demo access</a>
          </p>
        </div>
        <svg class="graphic" viewBox="0 0 520 420" role="img" aria-label="A small graph: farms supply milk lots, which are tested and made into batches that go to retailers">
          <defs>
            <linearGradient id="n1" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#5cc7d8"/><stop offset="1" stop-color="#0498ab"/></linearGradient>
            <linearGradient id="n2" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#8a7bf0"/><stop offset="1" stop-color="#4a3fb5"/></linearGradient>
            <linearGradient id="n3" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#34d3a0"/><stop offset="1" stop-color="#0f9d78"/></linearGradient>
            <linearGradient id="n4" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#ffb35c"/><stop offset="1" stop-color="#e0742a"/></linearGradient>
            <linearGradient id="n5" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#2a6fb0"/><stop offset="1" stop-color="#16407a"/></linearGradient>
            <filter id="glow" x="-30%" y="-30%" width="160%" height="160%"><feDropShadow dx="0" dy="6" stdDeviation="8" flood-color="#000" flood-opacity=".35"/></filter>
          </defs>
          <g stroke="#5cc7d8" stroke-opacity=".55" stroke-width="2.5" fill="none" stroke-linecap="round">
            <path d="M120 100 C150 140 200 160 235 185"/>
            <path d="M345 185 C360 150 360 125 350 97"/>
            <path d="M250 238 C220 280 190 300 160 318"/>
            <path d="M320 238 C370 270 395 285 410 305"/>
            <path d="M180 74 C220 70 250 68 285 71" stroke-dasharray="6 7"/>
          </g>
          <g filter="url(#glow)" font-family="Outfit, sans-serif" font-weight="600" font-size="17" fill="#fff" text-anchor="middle">
            <rect x="60" y="48" width="120" height="52" rx="16" fill="url(#n3)"/><text x="120" y="80">Farm</text>
            <rect x="215" y="180" width="130" height="58" rx="18" fill="url(#n1)"/><text x="280" y="215">MilkLot</text>
            <rect x="285" y="45" width="130" height="52" rx="16" fill="url(#n2)"/><text x="350" y="77">QualityTest</text>
            <rect x="80" y="318" width="140" height="52" rx="16" fill="url(#n4)"/><text x="150" y="350">Batch</text>
            <rect x="350" y="305" width="130" height="52" rx="16" fill="url(#n5)"/><text x="415" y="337">Retailer</text>
          </g>
          <g font-family="JetBrains Mono, monospace" font-size="12" fill="#a9e3ec" text-anchor="middle">
            <text x="150" y="156" transform="rotate(30 150 156)">supplies</text>
            <text x="378" y="150" transform="rotate(-80 378 150)">measures</text>
            <text x="190" y="290" transform="rotate(-38 190 290)">madeFrom</text>
            <text x="378" y="282" transform="rotate(30 378 282)">soldTo</text>
          </g>
        </svg>
      </div>
    </section>

    <section class="strip">
      <div class="wrap strip-grid">
        {facts.map((f) => <div><b>{f.big}</b><span>{f.small}</span></div>)}
      </div>
    </section>

    <section class="band" id="quick">
      <div class="wrap">
        <h2>Up and running in five minutes</h2>
        <p class="sub">A live demo on a synthetic dairy cooperative. Book a short walkthrough, get a passcode, and ask your first question in the console or from code.</p>
        <div class="steps">
          <div class="step"><span class="num">01</span><div><h3>Get a passcode</h3><p>Book a 20-minute walkthrough. Straight after booking you are shown a passcode, valid for seven days.</p></div><div class="codes"><a class="btn solid big" href="https://demo.graphowl.app/__access">Get a passcode</a><p class="note">Or email connect@graphowl.app and we will send one.</p></div></div>
          <div class="step"><span class="num">02</span><div><h3>Open the console</h3><p>Go to demo.graphowl.app and enter the passcode. Open <b>Query</b> in the left menu, paste a question and run it.</p></div><pre><code>{sparql}</code></pre></div>
          <div class="step"><span class="num">03</span>
            <div><h3>Or call it from code</h3><p>The passcode is also your API key: send it as a bearer token.</p>
              <div class="tabs" role="tablist" aria-label="Language">
                <button role="tab" aria-selected="true" data-tab="curl">curl</button>
                <button role="tab" aria-selected="false" data-tab="py">Python</button>
                <button role="tab" aria-selected="false" data-tab="ts">TypeScript</button>
              </div>
            </div>
            <div class="codes">
              <pre data-pane="curl"><code>{curl}</code></pre>
              <pre data-pane="py" hidden><code>{py}</code></pre>
              <pre data-pane="ts" hidden><code>{ts}</code></pre>
            </div>
          </div>
        </div>
        <p class="more"><a href="https://docs.graphowl.app/start/quickstart/">Read the full quickstart →</a></p>
      </div>
    </section>

    <section class="band" id="pillars">
      <div class="wrap">
        <h2>One model, four jobs</h2>
        <p class="sub">A semantic model is only useful if it does work. GraphOWL uses the same approved model to reach data, justify answers, govern change and constrain agents.</p>
        <div class="cards two-up">
          {pillars.map((p) => (
            <article class={`card c-${p.color}`}><span class="tag">{p.tag}</span><h3>{p.title}</h3><p>{p.text}</p></article>
          ))}
        </div>
      </div>
    </section>

    <section class="band alt" id="use-cases">
      <div class="wrap">
        <h2>What people use it for</h2>
        <p class="sub">One engine, many domains. A data catalog, a compliance model or a product domain is one pack on the same engine.</p>
        <div class="cards">
          {useCases.map((u) => (
            <article class={`card c-${u.color}`}><span class="tag">{u.tag}</span><h3>{u.title}</h3><p>{u.text}</p></article>
          ))}
        </div>
      </div>
    </section>

    <section class="band" id="features">
      <div class="wrap">
        <h2>What is in the engine</h2>
        <p class="sub">The pieces the four jobs rest on.</p>
        <div class="feat">
          {features.map((f) => <div><h3>{f.title}</h3><p>{f.text}</p></div>)}
        </div>
      </div>
    </section>

    <section class="band alt" id="behaves">
      <div class="wrap">
        <h2>How it behaves</h2>
        <p class="sub">Three properties that follow from how the engine is built, and that you can check.</p>
        <img class="diagram" src="/assets/time-travel.svg" alt="Every fact keeps its history; an asOf cursor sits between two transactions" loading="lazy" />
        <img class="diagram" src="/assets/review-flow.svg" alt="Proposals flow from software and agents to a review queue, then the approved model, then the graph" loading="lazy" />
        <img class="diagram" src="/assets/reasoning.svg" alt="Stated facts, and a derived conclusion marked as derived" loading="lazy" />
      </div>
    </section>

    <section class="band" id="agents">
      <div class="wrap">
        <h2>Context an AI assistant can trust</h2>
        <p class="sub">GraphOWL includes an MCP server with 101 tools. An assistant can look things up, follow relationships, run queries, propose changes and record what it learned. Every answer traces to facts and rules; agents propose and people decide.</p>
        <img class="diagram" src="/assets/mcp-flow.svg" alt="An AI assistant calls the MCP server, which offers five families of tools over the graph" loading="lazy" />
        <p class="more"><a href="https://docs.graphowl.app/ai/mcp-overview/">Read the MCP guide →</a> &nbsp; <a href="https://docs.graphowl.app/cookbooks/agent-memory/">Agent memory cookbook →</a></p>
      </div>
    </section>

    <section class="band alt" id="see">
      <div class="wrap">
        <h2>See it</h2>
        <p class="sub">The console on a synthetic dairy cooperative: farms, milk lots, quality tests, batches and sales as one connected graph.</p>
        <img class="shot" src="/assets/console-overview.jpg" alt="The GraphOWL console showing a synthetic dairy cooperative" width="1200" loading="lazy" />
      </div>
    </section>

    <section class="band" id="how">
      <div class="wrap">
        <h2>How it works</h2>
        <p class="sub">From scattered data to answers you can trust, in five steps. Every step is reviewed, dated and traceable.</p>
        <img class="diagram" src="/assets/pipeline.svg" alt="Connect, model, review, ask and check, serve" loading="lazy" />
        <img class="diagram" src="/assets/architecture.svg" alt="One engine, three layers: people and agents, domain models, the engine" loading="lazy" />
        <img class="diagram" src="/assets/api-surface.svg" alt="The console, HTTP API, MCP server and operations routes around the engine" loading="lazy" />
      </div>
    </section>

    <section class="band" id="cookbooks">
      <div class="wrap">
        <h2>Worked scenarios</h2>
        <p class="sub">Each cookbook starts from a question someone actually asks, and every query in it was run against the live demo.</p>
        <div class="cards">
          <a class="card c-a" href="https://docs.graphowl.app/cookbooks/dairy-traceability/"><span class="tag">Trace</span><h3>Dairy traceability</h3><p>A quality test failed: which lot, which batches, which retailers to call?</p></a>
          <a class="card c-b" href="https://docs.graphowl.app/cookbooks/data-catalog/"><span class="tag">Catalog</span><h3>A data catalog</h3><p>What do we have, who owns it, what depends on it?</p></a>
          <a class="card c-c" href="https://docs.graphowl.app/cookbooks/compliance-rules/"><span class="tag">Rules</span><h3>Rules and compliance</h3><p>Which records break which rule, and has anyone accepted the exception?</p></a>
          <a class="card c-d" href="https://docs.graphowl.app/cookbooks/agent-memory/"><span class="tag">Agents</span><h3>Agent memory</h3><p>How does an assistant remember what it learned, on the record?</p></a>
        </div>
      </div>
    </section>

    <section class="band alt" id="compare">
      <div class="wrap">
        <h2>How it differs</h2>
        <p class="sub">Compared by category, on rows you can check. A general database stores rows; a graph database stores connections; GraphOWL also keeps what the connections <em>mean</em>.</p>
        <div class="tablewrap">
          <table>
            <thead><tr><th></th><th class="us">GraphOWL</th><th>Relational database</th><th>Property-graph server</th></tr></thead>
            <tbody>
              {comparison.map((r) => (
                <tr><th scope="row">{r[0]}</th><td class="us">{r[1]}</td><td>{r[2]}</td><td>{r[3]}</td></tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="note">Categories describe typical products, not every one. If a row is wrong for a tool you use, tell us. <a href="/compare/">Read the full comparison, including where the others are stronger →</a></p>
      </div>
    </section>

    <section class="band alt" id="direction">
      <div class="wrap">
        <h2>Where it is going</h2>
        <p class="sub">GraphOWL is early access. These are the capabilities we are building toward, in no particular order. They are not all in the demo today; <a href="https://docs.graphowl.app/reference/limits/">known limits</a> says what is.</p>
        <div class="feat three">
          {direction.map((d) => <div><h3>{d.title}</h3><p>{d.text}</p></div>)}
        </div>
      </div>
    </section>

    <section class="band" id="rust">
      <div class="wrap">
        <h2>Built in Rust</h2>
        <p class="sub">The server is written in Rust, as a workspace of small, single-purpose crates.</p>
        <div class="feat three">
          <div><h3>Safe and steady</h3><p>Memory safety without a garbage collector: whole classes of crashes and security flaws cannot be written in safe code, and there are no collector pauses to show up as latency spikes.</p></div>
          <div><h3>One server to run</h3><p>The server, the API and the console ship as one program. No runtime or virtual machine to install, and few moving parts to operate.</p></div>
          <div><h3>Rules in the types</h3><p>A fact has a source, a derived fact is marked derived, a model change needs review. These are encoded in types, so breaking them is a compile error.</p></div>
        </div>
        <p class="note">No benchmark figures are claimed yet; they will be published with the method that produced them.</p>
      </div>
    </section>

    <section class="band alt" id="run">
      <div class="wrap">
        <h2>Two ways to run it</h2>
        <img class="diagram" src="/assets/run-options.svg" alt="The hosted demo and the early-access container" loading="lazy" />
        <div class="two">
          <article class="run a">
            <h3>Try the hosted demo</h3>
            <p>A live server loaded with a synthetic dairy cooperative. Password-protected while GraphOWL is in early access: email for a login.</p>
            <a class="btn solid" href="mailto:connect@graphowl.app?subject=GraphOWL%20demo%20access">Request demo access</a>
          </article>
          <article class="run b">
            <h3>Run it yourself</h3>
            <p>An early-access container: PostgreSQL with pgvector and one server, started with <code>docker compose</code>, on amd64 or arm64. Provided under an evaluation licence.</p>
            <a class="btn solid" href="https://docs.graphowl.app/operators/deploy/">Read how</a>
          </article>
        </div>
      </div>
    </section>

    <section class="band" id="open">
      <div class="wrap">
        <h2>What is open, and what is not</h2>
        <div class="two">
          <article class="open">
            <h3>Public</h3>
            <ul>
              <li>Documentation and the full API description</li>
              <li>Client libraries (Python and TypeScript, Apache-2.0)</li>
              <li>Runnable examples and sample data</li>
              <li>Standards conformance, dated</li>
              <li>Software bill of materials and licences</li>
              <li>Issues, discussions and a security policy</li>
            </ul>
          </article>
          <article class="open">
            <h3>Not public</h3>
            <ul>
              <li>The server's source code: it is proprietary</li>
              <li>Production use is not covered by the evaluation licence</li>
            </ul>
            <p class="note">GraphOWL is in <strong>early access</strong>: the API may change before 1.0, and <a href="https://docs.graphowl.app/reference/limits/">known limits</a> are listed plainly.</p>
          </article>
        </div>
      </div>
    </section>

    <section class="final">
      <div class="wrap">
        <h2>Start with the quickstart</h2>
        <p>Five minutes to a first question, on the demo or on your own machine.</p>
        <p><a class="btn solid big" href="https://docs.graphowl.app/start/quickstart/">Get started</a> <a class="btn ghost big" href="https://github.com/graphowl/graphowl">View on GitHub</a></p>
      </div>
    </section>

    <footer>
      <div class="wrap foot">
        <div><a class="brand" href="/"><img src="/assets/owl.png" alt="" width="28" height="28" /><span>Graph<b>OWL</b></span></a><p>The knowledge graph engine.</p></div>
        <div><h4>Product</h4><a href="#features">Features</a><a href="#use-cases">Use cases</a><a href="#run">Run it</a><a href="/compare/">Compare</a></div>
        <div><h4>Resources</h4><a href="https://docs.graphowl.app/">Documentation</a><a href="https://docs.graphowl.app/api/reference/">API reference</a><a href="https://docs.graphowl.app/ai/mcp-overview/">MCP and agents</a><a href="https://docs.graphowl.app/cookbooks/">Cookbooks</a><a href="https://github.com/graphowl/examples">Examples</a></div>
